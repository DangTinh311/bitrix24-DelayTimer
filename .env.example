# Cloudflare Workers Environment Variables
# Copy this file to .env and fill in your values

# Cloudflare Account Details
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# KV Namespace IDs (create these in Cloudflare dashboard)
DELAY_TIMER_KV_ID=your_kv_namespace_id
DELAY_TIMER_KV_PREVIEW_ID=your_preview_kv_namespace_id

# Queue Name (will be created automatically)
DELAY_QUEUE_NAME=delay-processing-queue

# Application Settings
MAX_DELAY_HOURS=24
DEFAULT_DELAY_SECONDS=30
ENVIRONMENT=development

# Bitrix24 Integration (if needed for callbacks)
BITRIX24_WEBHOOK_SECRET=your_webhook_secret

# Monitoring & Analytics
ENABLE_ANALYTICS=true
LOG_LEVEL=info

# Custom Domain (optional)
CUSTOM_DOMAIN=delay-timer.yourdomain.com